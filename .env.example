# Backend base URL
# Local: http://localhost:3001
# Produccion/Vercel: https://<tu-backend>
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL publica del frontend
# Local: http://localhost:3000
# Produccion/Vercel: https://<tu-frontend>
NEXTAUTH_URL=http://localhost:3000

# Requerido en todos los entornos. Usar un valor fuerte en produccion.
NEXTAUTH_SECRET=local-development-secret-change-me

# Opcional. Solo si esta habilitado el flujo PayPal.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Habilita u oculta el login con Google en UI.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Opcional para login con Google.
# Si quedan vacias, el frontend levanta igual y NextAuth omite ese provider.
# Para habilitar el boton en UI, cambiar NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
